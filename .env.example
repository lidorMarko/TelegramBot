# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=jobsense
MONGO_COLLECTION=companies

# Job field names (embedded in latestJobs array)
FIELD_TITLE=title
FIELD_LOCATION=location
FIELD_DESCRIPTION=description
FIELD_URL=url
FIELD_FIRST_SEEN=firstSeenAt
FIELD_STATUS=status
FIELD_JOB_HASH=jobHash

# Company field names
FIELD_COMPANY_NAME=name
FIELD_LATEST_JOBS=latestJobs

# Polling interval in seconds
POLL_INTERVAL=30

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
REVIEW_CHANNEL_ID=-100xxxxxxxxx        # private GROUP where reviewers click approve/reject
TELEGRAM_PROD_CHANNEL_ID=-100xxxxxxxxx # public channel where approved jobs are posted
