# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
REVIEW_CHANNEL_ID=-100xxxxxxxxx        # private group where reviewers click approve/reject
TELEGRAM_PROD_CHANNEL_ID=-100xxxxxxxxx # public channel where approved jobs are posted

# ── File paths ─────────────────────────────────────────────────────────────────
# Path to the companies.json produced by the jobsense Spring Boot app
COMPANIES_JSON_PATH=../jobsense/data/companies.json
# Where the bot stores its review queue
REVIEW_QUEUE_JSON_PATH=data/review_queue.json

# ── Optional ───────────────────────────────────────────────────────────────────
# Polling interval in seconds (default: 30)
# POLL_INTERVAL=30
